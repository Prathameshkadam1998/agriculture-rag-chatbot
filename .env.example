# Reference for the app's environment variables. Export them in your shell
# (or load this file with: set -a; source .env; set +a), or set them in your
# host's dashboard. Everything is optional - with nothing set, the app answers by quoting the
# best match from the knowledge base.

# --- Answer writer -----------------------------------------------------------
# auto        use the LLM when LLM_API_KEY and LLM_MODEL are set, else extractive
# extractive  quote the best-matching answer (no model, no key)
# llm         any OpenAI-compatible chat API
GENERATOR=auto

# OpenAI-compatible endpoint. Groq, OpenRouter, a local Ollama, etc.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=

# --- Performance -------------------------------------------------------------
ONNX_THREADS=1
# Candidates the cross-encoder re-scores per question. Lower = faster on a slow CPU.
RERANK_POOL=20
RATE_LIMIT_PER_MINUTE=30

# --- Paths -------------------------------------------------------------------
# MODEL_CACHE_DIR=.models
# INDEX_DIR=data/index
